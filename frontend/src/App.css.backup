* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #f7f8fc;
  color: #171717;
}

button {
  cursor: pointer;
  border: none;
}

.navbar {
  height: 70px;
  background: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6%;
  box-shadow: 0 2px 12px rgba(0,0,0,.06);
  position: sticky;
  top: 0;
  z-index: 20;
}

.logo {
  font-size: 24px;
  font-weight: 800;
  cursor: pointer;
}

nav {
  display: flex;
  gap: 8px;
  align-items: center;
}

nav button {
  background: transparent;
  padding: 10px 12px;
  font-size: 14px;
}

nav button:hover {
  color: #2563eb;
}

.hero {
  max-width: 1200px;
  margin: 35px auto;
  padding: 60px;
  border-radius: 28px;
  background: linear-gradient(135deg, #eef4ff, #ffffff);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
}

.hero-label {
  color: #2563eb;
  font-weight: 800;
  letter-spacing: 3px;
}

.hero h1 {
  font-size: 52px;
  line-height: 1.05;
  margin: 15px 0;
}

.hero-text {
  color: #666;
  font-size: 18px;
  max-width: 520px;
  line-height: 1.6;
}

.hero-image {
  width: 380px;
  height: 300px;
  overflow: hidden;
  border-radius: 24px;
}

.hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.primary-button {
  background: #2563eb;
  color: white;
  padding: 14px 24px;
  border-radius: 10px;
  font-weight: 700;
  margin-top: 15px;
}

.primary-button:hover {
  background: #1d4ed8;
}

.products-section {
  max-width: 1200px;
  margin: 70px auto;
  padding: 0 20px;
}

.section-heading {
  text-align: center;
  margin-bottom: 30px;
}

.section-heading h2 {
  font-size: 34px;
  margin-bottom: 8px;
}

.section-heading p {
  color: #777;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.product-card {
  background: white;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 5px 25px rgba(0,0,0,.08);
  transition: .2s;
}

.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 30px rgba(0,0,0,.12);
}

.product-image-wrapper {
  height: 240px;
  background: #f1f5f9;
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.product-info {
  padding: 20px;
}

.category {
  color: #2563eb;
  font-size: 13px;
  font-weight: 700;
}

.product-info h3 {
  margin: 8px 0;
  font-size: 20px;
}

.price {
  font-size: 22px;
  font-weight: 800;
  margin: 12px 0;
}

.stock {
  color: #16a34a;
  font-size: 14px;
}

.product-actions {
  display: flex;
  gap: 8px;
  margin-top: 15px;
}

.cart-button,
.buy-button {
  flex: 1;
  padding: 11px 8px;
  border-radius: 8px;
  font-weight: 700;
}

.cart-button {
  background: #e5edff;
  color: #2563eb;
}

.buy-button {
  background: #2563eb;
  color: white;
}

.toast {
  position: fixed;
  right: 25px;
  top: 85px;
  z-index: 100;
  background: #111827;
  color: white;
  padding: 14px 20px;
  border-radius: 10px;
}

.page-section {
  max-width: 900px;
  margin: 60px auto;
  padding: 30px;
  background: white;
  border-radius: 18px;
}

.cart-item {
  display: flex;
  gap: 20px;
  padding: 15px;
  margin: 15px 0;
  border-bottom: 1px solid #eee;
}

.cart-item img {
  width: 100px;
  height: 100px;
  object-fit: cover;
  border-radius: 10px;
}

.auth-page {
  min-height: 70vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

.auth-card {
  width: 400px;
  background: white;
  padding: 35px;
  border-radius: 18px;
  box-shadow: 0 10px 35px rgba(0,0,0,.1);
}

.auth-card input {
  width: 100%;
  padding: 13px;
  margin: 8px 0;
  border: 1px solid #ddd;
  border-radius: 8px;
}

.full {
  width: 100%;
}

.link-button {
  background: none;
  color: #2563eb;
  font-weight: 700;
}

footer {
  margin-top: 80px;
  padding: 30px;
  text-align: center;
  background: #111827;
  color: white;
}

@media (max-width: 1000px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero {
    margin: 20px;
  }
}

@media (max-width: 650px) {
  .navbar {
    height: auto;
    padding: 15px;
    flex-direction: column;
    gap: 10px;
  }

  nav {
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero {
    padding: 30px;
    flex-direction: column;
  }

  .hero h1 {
    font-size: 38px;
  }

  .hero-image {
    width: 100%;
  }

  .products-grid {
    grid-template-columns: 1fr;
  }
}
