import React, { useEffect, useState } from "react";
import "./App.css";

const API = "http://127.0.0.1:8001";

const PRODUCT_IMAGES = {
  1: "https://images.pexels.com/photos/3394656/pexels-photo-3394656.jpeg?auto=compress&cs=tinysrgb&w=900",
  2: "https://images.pexels.com/photos/437037/pexels-photo-437037.jpeg?auto=compress&cs=tinysrgb&w=900",
  3: "https://images.pexels.com/photos/1294731/pexels-photo-1294731.jpeg?auto=compress&cs=tinysrgb&w=900",
  4: "https://images.pexels.com/photos/2529148/pexels-photo-2529148.jpeg?auto=compress&cs=tinysrgb&w=900",
};

const FALLBACK_PRODUCTS = [
  {
    id: 1,
    name: "Wireless Headphones",
    category: "Electronics",
    price: 2499,
    stock: 25,
    popularity: 95,
  },
  {
    id: 2,
    name: "Smart Watch",
    category: "Electronics",
    price: 3999,
    stock: 15,
    popularity: 90,
  },
  {
    id: 3,
    name: "Laptop Backpack",
    category: "Accessories",
    price: 1499,
    stock: 40,
    popularity: 80,
  },
  {
    id: 4,
    name: "Running Shoes",
    category: "Fashion",
    price: 2999,
    stock: 20,
    popularity: 85,
  },
];

function App() {
  const [page, setPage] = useState("shop");
  const [products, setProducts] = useState(FALLBACK_PRODUCTS);
  const [cart, setCart] = useState([]);
  const [orders, setOrders] = useState([]);
  const [notifications, setNotifications] = useState([]);
  const [message, setMessage] = useState("");
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("All");
  const [user, setUser] = useState(() => {
    try {
      return JSON.parse(localStorage.getItem("smartcart_user")) || null;
    } catch {
      return null;
    }
  });

  useEffect(() => {
    loadProducts();
  }, []);

  useEffect(() => {
    if (user) {
      loadOrders();
      loadNotifications();
    }
  }, [user]);

  async function loadProducts() {
    try {
      const response = await fetch(`${API}/products`);
      const data = await response.json();

      if (Array.isArray(data) && data.length) {
        setProducts(
          data.map((product) => ({
            ...product,
            image:
              PRODUCT_IMAGES[product.id] ||
              PRODUCT_IMAGES[1],
          }))
        );
      }
    } catch {
      setProducts(
        FALLBACK_PRODUCTS.map((product) => ({
          ...product,
          image: PRODUCT_IMAGES[product.id],
        }))
      );
    }
  }

  async function loadOrders() {
    if (!user) return;

    try {
      const response = await fetch(
        `${API}/orders?email=${encodeURIComponent(user.email)}`
      );

      if (response.ok) {
        const data = await response.json();
        setOrders(Array.isArray(data) ? data : []);
      }
    } catch {
      setOrders([]);
    }
  }

  async function loadNotifications() {
    if (!user) return;

    try {
      const response = await fetch(
        `${API}/notifications?email=${encodeURIComponent(user.email)}`
      );

      if (response.ok) {
        const data = await response.json();
        setNotifications(Array.isArray(data) ? data : []);
      }
    } catch {
      setNotifications([]);
    }
  }

  function showMessage(text) {
    setMessage(text);
    setTimeout(() => setMessage(""), 3000);
  }

  function addToCart(product) {
    setCart((current) => {
      const existing = current.find(
        (item) => item.id === product.id
      );

      if (existing) {
        return current.map((item) =>
          item.id === product.id
            ? {
                ...item,
                quantity: item.quantity + 1,
              }
            : item
        );
      }

      return [
        ...current,
        {
          ...product,
          quantity: 1,
        },
      ];
    });

    showMessage(`${product.name} added to cart`);
  }

  function removeFromCart(id) {
    setCart((current) =>
      current.filter((item) => item.id !== id)
    );
  }

  function updateQuantity(id, quantity) {
    if (quantity < 1) {
      removeFromCart(id);
      return;
    }

    setCart((current) =>
      current.map((item) =>
        item.id === id
          ? { ...item, quantity }
          : item
      )
    );
  }

  async function buyNow(product) {
    if (!user) {
      showMessage("Please login before purchasing");
      setPage("login");
      return;
    }

    try {
      const response = await fetch(`${API}/buy`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          email: user.email,
          product_id: product.id,
          quantity: 1,
          payment_method: "stripe",
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        showMessage(
          data.detail || "Payment failed"
        );
        return;
      }

      showMessage(
        `Payment successful! Order #${data.order_id}`
      );

      loadOrders();
      loadNotifications();
    } catch {
      showMessage(
        "Payment service unavailable. Start FastAPI on port 8001."
      );
    }
  }

  async function checkoutCart() {
    if (!user) {
      showMessage("Please login before checkout");
      setPage("login");
      return;
    }

    if (!cart.length) {
      showMessage("Your cart is empty");
      return;
    }

    try {
      for (const item of cart) {
        const response = await fetch(`${API}/buy`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            email: user.email,
            product_id: item.id,
            quantity: item.quantity,
            payment_method: "stripe",
          }),
        });

        if (!response.ok) {
          const data = await response.json();
          showMessage(
            data.detail || "Checkout failed"
          );
          return;
        }
      }

      setCart([]);
      showMessage("Order placed successfully!");
      loadOrders();
      loadNotifications();
      setPage("orders");
    } catch {
      showMessage("Checkout service unavailable");
    }
  }

  async function login(email, password) {
    try {
      const response = await fetch(`${API}/login`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          email,
          password,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        showMessage(
          data.detail || "Invalid email or password"
        );
        return;
      }

      const loggedUser = {
        name:
          data.name ||
          data.user?.name ||
          email.split("@")[0],
        email,
      };

      localStorage.setItem(
        "smartcart_user",
        JSON.stringify(loggedUser)
      );

      setUser(loggedUser);
      setPage("shop");
      showMessage("Login successful");
    } catch {
      showMessage("FastAPI authentication unavailable");
    }
  }

  async function register(name, email, password) {
    try {
      const response = await fetch(`${API}/register`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          name,
          email,
          password,
        }),
      });

      const data = await response.json();

      if (!response.ok) {
        showMessage(
          data.detail || "Registration failed"
        );
        return;
      }

      showMessage(
        "Registration successful. Please login."
      );

      setPage("login");
    } catch {
      showMessage("Registration service unavailable");
    }
  }

  function logout() {
    localStorage.removeItem("smartcart_user");
    setUser(null);
    setCart([]);
    setOrders([]);
    setNotifications([]);
    setPage("shop");
    showMessage("Logged out successfully");
  }

  const categories = [
    "All",
    ...new Set(
      products.map((product) => product.category)
    ),
  ];

  const filteredProducts = products.filter(
    (product) => {
      const matchesSearch =
        product.name
          .toLowerCase()
          .includes(search.toLowerCase());

      const matchesCategory =
        category === "All" ||
        product.category === category;

      return matchesSearch && matchesCategory;
    }
  );

  const cartTotal = cart.reduce(
    (total, item) =>
      total + Number(item.price) * item.quantity,
    0
  );

  return (
    <div className="app">
      <header className="navbar">
        <div
          className="logo"
          onClick={() => setPage("shop")}
        >
          ??? <span>SmartCart</span>
        </div>

        <nav>
          <button onClick={() => setPage("shop")}>
            Shop
          </button>

          <button onClick={() => setPage("orders")}>
            Orders
          </button>

          <button
            onClick={() => setPage("notifications")}
          >
            Notifications
            <span className="badge">
              {notifications.length}
            </span>
          </button>

          <button onClick={() => setPage("cart")}>
            Cart
            <span className="badge">
              {cart.reduce(
                (sum, item) => sum + item.quantity,
                0
              )}
            </span>
          </button>

          {user ? (
            <>
              <button
                onClick={() => setPage("profile")}
              >
                ?? {user.name}
              </button>

              <button
                className="logout-button"
                onClick={logout}
              >
                Logout
              </button>
            </>
          ) : (
            <>
              <button
                onClick={() => setPage("login")}
              >
                Log in
              </button>

              <button
                className="signup-button"
                onClick={() => setPage("register")}
              >
                Sign up
              </button>
            </>
          )}
        </nav>
      </header>

      {message && (
        <div className="toast">
          ? {message}
        </div>
      )}

      {page === "shop" && (
        <main>
          <section className="hero">
            <div className="hero-content">
              <div className="hero-label">
                SMART SHOPPING
              </div>

              <h1>
                Everything you need.
                <br />
                <span>All in one place.</span>
              </h1>

              <p>
                Discover quality products with secure
                checkout and easy order tracking.
              </p>

              <button
                className="hero-button"
                onClick={() =>
                  document
                    .getElementById("products")
                    ?.scrollIntoView({
                      behavior: "smooth",
                    })
                }
              >
                Shop Now
              </button>
            </div>

            <div className="hero-product">
              <img
                src={PRODUCT_IMAGES[1]}
                alt="Wireless headphones"
              />
              <div className="floating-card">
                Top Rated
              </div>
            </div>
          </section>

          <section
            id="products"
            className="products-section"
          >
            <div className="section-title">
              <div>
                <p className="small-title">
                  OUR COLLECTION
                </p>

                <h2>Featured Products</h2>

                <p>
                  Choose from our popular products
                </p>
              </div>
            </div>

            <div className="shop-controls">
              <input
                value={search}
                onChange={(e) =>
                  setSearch(e.target.value)
                }
                placeholder="?? Search products..."
              />

              <select
                value={category}
                onChange={(e) =>
                  setCategory(e.target.value)
                }
              >
                {categories.map((item) => (
                  <option key={item}>
                    {item}
                  </option>
                ))}
              </select>
            </div>

            <div className="products-grid">
              {filteredProducts.map(
                (product) => (
                  <article
                    className="product-card"
                    key={product.id}
                  >
                    <div className="product-image">
                      <img
                        src={
                          product.image ||
                          PRODUCT_IMAGES[
                            product.id
                          ] ||
                          PRODUCT_IMAGES[1]
                        }
                        alt={product.name}
                      />

                      <span className="popular">
                        Popular
                      </span>
                    </div>

                    <div className="product-details">
                      <span className="category">
                        {product.category}
                      </span>

                      <h3>{product.name}</h3>

                      <div className="rating">
                        4.8
                      </div>

                      <div className="price-row">
                        <strong>
                          ?
                          {Number(
                            product.price
                          ).toLocaleString(
                            "en-IN"
                          )}
                        </strong>

                        <span>
                          {product.stock} available
                        </span>
                      </div>

                      <div className="product-actions">
                        <button
                          className="cart-button"
                          onClick={() =>
                            addToCart(product)
                          }
                        >
                          Add to Cart
                        </button>

                        <button
                          className="buy-button"
                          onClick={() =>
                            buyNow(product)
                          }
                        >
                          Buy Now
                        </button>
                      </div>
                    </div>
                  </article>
                )
              )}
            </div>
          </section>
        </main>
      )}

      {page === "cart" && (
        <CartPage
          cart={cart}
          cartTotal={cartTotal}
          updateQuantity={updateQuantity}
          removeFromCart={removeFromCart}
          checkoutCart={checkoutCart}
          setPage={setPage}
        />
      )}

      {page === "orders" && (
        <OrdersPage
          orders={orders}
          user={user}
          setPage={setPage}
        />
      )}

      {page === "notifications" && (
        <NotificationsPage
          notifications={notifications}
        />
      )}

      {page === "profile" && user && (
        <section className="content-page">
          <div className="profile-card">
            <div className="profile-icon">
              ??
            </div>

            <h2>{user.name}</h2>

            <p>{user.email}</p>

            <span className="role">
              Customer
            </span>

            <button
              className="primary-button"
              onClick={logout}
            >
              Logout
            </button>
          </div>
        </section>
      )}

      {page === "login" && (
        <AuthForm
          title="Welcome Back"
          buttonText="Log In"
          onSubmit={login}
          footerText="Don't have an account?"
          footerAction="Sign up"
          onFooter={() => setPage("register")}
        />
      )}

      {page === "register" && (
        <RegisterForm
          onRegister={register}
          onLogin={() => setPage("login")}
        />
      )}

      <footer>
        <div className="footer-logo">
          SmartCart
        </div>

        <p>
          Smart E-Commerce Platform
        </p>

        <small>
          � 2026 SmartCart � Secure shopping
        </small>
      </footer>
    </div>
  );
}

function AuthForm({
  title,
  buttonText,
  onSubmit,
  footerText,
  footerAction,
  onFooter,
}) {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");

  return (
    <section className="auth-page">
      <div className="auth-card">
        <div className="auth-icon">
          ??
        </div>

        <h2>{title}</h2>

        <p>
          Login to continue shopping with SmartCart.
        </p>

        <input
          type="email"
          placeholder="Email address"
          value={email}
          onChange={(e) =>
            setEmail(e.target.value)
          }
        />

        <input
          type="password"
          placeholder="Password"
          value={password}
          onChange={(e) =>
            setPassword(e.target.value)
          }
        />

        <button
          className="primary-button full"
          onClick={() =>
            onSubmit(email, password)
          }
        >
          {buttonText}
        </button>

        <p className="auth-footer">
          {footerText}{" "}
          <button
            className="link-button"
            onClick={onFooter}
          >
            {footerAction}
          </button>
        </p>
      </div>
    </section>
  );
}

function RegisterForm({
  onRegister,
  onLogin,
}) {
  const [name, setName] = useState("");
  const [email, setEmail] = useState("");
  const [password, setPassword] =
    useState("");

  return (
    <section className="auth-page">
      <div className="auth-card">
        <div className="auth-icon">
          ???
        </div>

        <h2>Create Account</h2>

        <p>
          Create your SmartCart account.
        </p>

        <input
          placeholder="Full name"
          value={name}
          onChange={(e) =>
            setName(e.target.value)
          }
        />

        <input
          type="email"
          placeholder="Email address"
          value={email}
          onChange={(e) =>
            setEmail(e.target.value)
          }
        />

        <input
          type="password"
          placeholder="Password"
          value={password}
          onChange={(e) =>
            setPassword(e.target.value)
          }
        />

        <button
          className="primary-button full"
          onClick={() =>
            onRegister(
              name,
              email,
              password
            )
          }
        >
          Create Account
        </button>

        <p className="auth-footer">
          Already have an account?{" "}
          <button
            className="link-button"
            onClick={onLogin}
          >
            Log in
          </button>
        </p>
      </div>
    </section>
  );
}

function CartPage({
  cart,
  cartTotal,
  updateQuantity,
  removeFromCart,
  checkoutCart,
  setPage,
}) {
  return (
    <section className="content-page">
      <div className="page-header">
        <div>
          <p className="small-title">
            SHOPPING
          </p>
          <h2>Your Cart</h2>
        </div>

        <button
          className="secondary-button"
          onClick={() => setPage("shop")}
        >
          ? Continue Shopping
        </button>
      </div>

      {!cart.length ? (
        <div className="empty-card">
          <div>??</div>
          <h3>Your cart is empty</h3>
          <p>
            Add products to your cart to continue.
          </p>

          <button
            className="primary-button"
            onClick={() => setPage("shop")}
          >
            Browse Products
          </button>
        </div>
      ) : (
        <div className="cart-layout">
          <div className="cart-list">
            {cart.map((item) => (
              <div
                className="cart-item"
                key={item.id}
              >
                <img
                  src={
                    item.image ||
                    PRODUCT_IMAGES[item.id]
                  }
                  alt={item.name}
                />

                <div className="cart-info">
                  <span className="category">
                    {item.category}
                  </span>

                  <h3>{item.name}</h3>

                  <strong>
                    ?
                    {Number(
                      item.price
                    ).toLocaleString(
                      "en-IN"
                    )}
                  </strong>
                </div>

                <div className="quantity">
                  <button
                    onClick={() =>
                      updateQuantity(
                        item.id,
                        item.quantity - 1
                      )
                    }
                  >
                    -
                  </button>

                  <span>
                    {item.quantity}
                  </span>

                  <button
                    onClick={() =>
                      updateQuantity(
                        item.id,
                        item.quantity + 1
                      )
                    }
                  >
                    +
                  </button>
                </div>

                <button
                  className="remove"
                  onClick={() =>
                    removeFromCart(item.id)
                  }
                >
                  Remove
                </button>
              </div>
            ))}
          </div>

          <div className="summary">
            <h3>Order Summary</h3>

            <div>
              <span>Items</span>
              <strong>{cart.length}</strong>
            </div>

            <div>
              <span>Subtotal</span>
              <strong>
                ?
                {cartTotal.toLocaleString(
                  "en-IN"
                )}
              </strong>
            </div>

            <div>
              <span>Shipping</span>
              <strong>FREE</strong>
            </div>

            <hr />

            <div className="total">
              <span>Total</span>
              <strong>
                ?
                {cartTotal.toLocaleString(
                  "en-IN"
                )}
              </strong>
            </div>

            <button
              className="primary-button full"
              onClick={checkoutCart}
            >
              Secure Checkout ?
            </button>
          </div>
        </div>
      )}
    </section>
  );
}

function OrdersPage({
  orders,
  user,
  setPage,
}) {
  return (
    <section className="content-page">
      <div className="page-header">
        <div>
          <p className="small-title">
            PURCHASE HISTORY
          </p>
          <h2>My Orders</h2>
        </div>

        <button
          className="secondary-button"
          onClick={() => setPage("shop")}
        >
          Continue Shopping
        </button>
      </div>

      {!user ? (
        <div className="empty-card">
          <div>??</div>
          <h3>Please login</h3>
          <p>
            Login to view your order history.
          </p>
        </div>
      ) : orders.length === 0 ? (
        <div className="empty-card">
          <div>??</div>
          <h3>No orders yet</h3>
          <p>
            Your completed orders will appear here.
          </p>
        </div>
      ) : (
        <div className="orders-list">
          {orders.map((order, index) => (
            <div
              className="order-card"
              key={
                order.id ||
                order.order_id ||
                index
              }
            >
              <div>
                <span>Order</span>

                <h3>
                  #
                  {order.id ||
                    order.order_id ||
                    index + 1}
                </h3>
              </div>

              <div>
                <span>Status</span>

                <strong className="status">
                  {order.order_status ||
                    order.status ||
                    "Placed"}
                </strong>
              </div>

              <div>
                <span>Payment</span>

                <strong className="paid">
                  {order.payment_status ||
                    "Paid"}
                </strong>
              </div>

              <div>
                <span>Total</span>

                <strong>
                  ?
                  {Number(
                    order.total_amount ||
                      order.total ||
                      0
                  ).toLocaleString(
                    "en-IN"
                  )}
                </strong>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>
  );
}

function NotificationsPage({
  notifications,
}) {
  return (
    <section className="content-page">
      <div className="page-header">
        <div>
          <p className="small-title">
            UPDATES
          </p>
          <h2>Notifications</h2>
        </div>
      </div>

      {!notifications.length ? (
        <div className="empty-card">
          <div>??</div>
          <h3>No notifications</h3>
          <p>
            Order and payment notifications will
            appear here.
          </p>
        </div>
      ) : (
        <div className="notification-list">
          {notifications.map(
            (notification, index) => (
              <div
                className="notification"
                key={
                  notification.id ||
                  index
                }
              >
                <div className="notification-icon">
                  ??
                </div>

                <div>
                  <strong>
                    {notification.type ||
                      "SmartCart Update"}
                  </strong>

                  <p>
                    {notification.message ||
                      notification.text ||
                      "New notification"}
                  </p>
                </div>
              </div>
            )
          )}
        </div>
      )}
    </section>
  );
}

export default App;


